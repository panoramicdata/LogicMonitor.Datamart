<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Panoramic Data Limited</Authors>
    <Copyright>Copyright © Panoramic Data Limited 2021-2026</Copyright>
    <PackageProjectUrl>https://github.com/panoramicdata/LogicMonitor.Datamart/</PackageProjectUrl>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>LogicMonitor Datamart</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>LogicMonitor API Datamart</PackageTags>
	<PackageReleaseNotes>
		- Postgres: the connection string is now built with NpgsqlConnectionStringBuilder instead of
		  being joined together by hand, so a database password containing a semicolon, a quote or
		  leading or trailing spaces reaches Postgres unchanged. A semicolon previously split the
		  password, and opening the connection failed with "Couldn't set ...;timezone".
		- Adds a direct reference to System.Security.Cryptography.Pkcs 10.0.13, replacing the 9.0.18
		  that Microsoft.Data.SqlClient 7.1.1 brings in (CVE-2026-84008, CVE-2026-70162).
		- Dependency floors raised since 3.240.27: LogicMonitor.Api 3.240.97, Microsoft.Data.SqlClient
		  7.1.1, PanoramicData.Mapper 10.0.52 and PanoramicData.NCalcExtensions 6.1.45. A consumer that
		  pins any of these lower must raise its pin, or restore fails with a downgrade error.
		- Tests: back on VSTest, since xUnit v2 has no Microsoft Testing Platform entry point and no
		  tests were being discovered.
	</PackageReleaseNotes>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/panoramicdata/LogicMonitor.Datamart/</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <UserSecretsId>d870b896-8725-450e-938a-3a75f2d9a8e8</UserSecretsId>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>LogicMonitor.Datamart</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PanoramicData.Mapper" />
    <PackageReference Include="EFCore.BulkExtensions.Dotnet10.PostgreSql" />
    <PackageReference Include="EFCore.BulkExtensions.Dotnet10.SqlServer" />
    <PackageReference Include="LogicMonitor.Api" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="PanoramicData.NCalcExtensions" />
    <!-- CVE-2026-84008, CVE-2026-70162: lifts the Pkcs 9.0.18 that Microsoft.Data.SqlClient brings in. Remove once SqlClient depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>